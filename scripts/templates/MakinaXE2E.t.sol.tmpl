// Faithful e2e for a makina-x (Safe-module) blueprint: drives the REAL deployed
// MakinaXModule on a fork, executing the exact compiled weiroll instructions as the Safe.
// makina-x is management-only (no on-chain NAV accounting) unless the module is WALLED.
pragma solidity ^0.8.28;

import {Test, console2} from "forge-std/Test.sol";

interface IERC20 {
    function balanceOf(address) external view returns (uint256);
    function decimals() external view returns (uint8);
}

interface IMakinaXModule {
    // ABI-compatible mirror of IWeirollComponent.Instruction (enum -> uint8).
    struct Instruction {
        uint256 positionId;
        bool isDebt;
        uint256 groupId;
        uint8 instructionType; // 0=MANAGEMENT 1=ACCOUNTING
        address[] affectedTokens;
        address[] positionTokens;
        bytes32[] commands;
        bytes[] state;
        uint128 stateBitmap;
        bytes32[] merkleProof;
    }

    function managePosition(Instruction calldata mgmt, Instruction calldata acct)
        external
        returns (uint256, int256);
    function setAllowedInstrRoot(bytes32 newRoot) external;
    function addOperator(address newOperator) external;
    function setFeedRoute(address token, address feed1, address feed2) external;
    function allowedInstrRoot() external view returns (bytes32);
    function operatingMode() external view returns (uint8);
    function safe() external view returns (address);
}

contract MakinaXE2E is Test {
    // ---- deployed wiring (from caliber.yaml) ----
    address constant MODULE = @@MODULE@@;
    address constant SAFE = @@SAFE@@;

    // ---- tokens ----
    address constant BASE = @@BASE_TOKEN@@; // supplied asset
    address constant POSITION_TOKEN = @@POSITION_TOKEN@@; // caliber position token (e.g. aToken)
    uint256 constant DEFAULT_AMOUNT = @@DEFAULT_AMOUNT@@; // base-token deposit amount (already scaled)

    // transpiler merkle root from the compiled rootfile (composite over all instructions)
    bytes32 constant TRANSPILER_ROOT = @@TRANSPILER_ROOT@@;
    bool constant CHECK_COMPOSITE_ROOT = @@CHECK_COMPOSITE_ROOT@@; // true only when exactly 2 leaves
    uint8 constant WALLED = 2;

    address operator = makeAddr("makinaxTestOperator");

    function setUp() public {
        vm.createSelectFork(vm.rpcUrl("@@RPC_ALIAS@@"));
    }

    // ---- leaf helpers: byte-for-byte copies of WeirollComponent internals ----
    function _stateHash(bytes[] memory state, uint128 bitmap) internal pure returns (bytes32) {
        if (bitmap == uint128(0)) return bytes32(0);
        bytes memory hashInput;
        for (uint256 i; i < state.length; ++i) {
            if (bitmap & (uint128(0x80000000000000000000000000000000) >> i) != 0) {
                hashInput = bytes.concat(hashInput, keccak256(state[i]));
            }
        }
        return keccak256(hashInput);
    }

    function _leaf(IMakinaXModule.Instruction memory ix) internal pure returns (bytes32) {
        return keccak256(
            abi.encode(
                keccak256(
                    abi.encode(
                        keccak256(abi.encodePacked(ix.commands)),
                        _stateHash(ix.state, ix.stateBitmap),
                        ix.stateBitmap,
                        ix.positionId,
                        ix.isDebt,
                        ix.groupId,
                        keccak256(abi.encodePacked(ix.affectedTokens)),
                        keccak256(abi.encodePacked(ix.positionTokens)),
                        ix.instructionType
                    )
                )
            )
        );
    }

    // ---- instruction builders (generated from the compiled rootfile) ----
    function _depositInstr(uint256 amount) internal pure returns (IMakinaXModule.Instruction memory ix) {
@@DEPOSIT_BUILDER@@
    }

    function _withdrawInstr(uint256 amount) internal pure returns (IMakinaXModule.Instruction memory ix) {
@@WITHDRAW_BUILDER@@
    }

    function _acctInstr() internal pure returns (IMakinaXModule.Instruction memory ix) {
@@ACCT_BUILDER@@
    }

    function _emptyInstr() internal pure returns (IMakinaXModule.Instruction memory ix) {
        ix.affectedTokens = new address[](0);
        ix.positionTokens = new address[](0);
        ix.commands = new bytes32[](0);
        ix.state = new bytes[](0);
        ix.merkleProof = new bytes32[](0);
    }

    function _setupFeeds() internal {
        // WALLED-only: register oracle feed routes so _valueOf works. No-op when empty.
        vm.startPrank(SAFE);
@@FEEDS_SETUP@@
        vm.stopPrank();
    }

    // ---- compile validation: recomputed composite root == transpiler root ----
    function test_compiledRootMatchesTranspiler() public pure {
        if (!CHECK_COMPOSITE_ROOT) {
            console2.log("composite-root check skipped (leaf count != 2); per-action leaves validated by execution");
            return;
        }
        bytes32 lD = _leaf(_depositInstr(123)); // amount excluded from leaf
        bytes32 lW = _leaf(_withdrawInstr(456));
        bytes32 root = lD < lW ? keccak256(abi.encodePacked(lD, lW)) : keccak256(abi.encodePacked(lW, lD));
        console2.logBytes32(root);
        assertEq(root, TRANSPILER_ROOT, "compiled merkle root does not match on-chain leaf encoding");
    }

    // ---- deposit -> withdraw lifecycle through the real module ----
    function test_depositThenWithdraw() public {
        assertEq(IMakinaXModule(MODULE).safe(), SAFE, "safe mismatch");
        uint8 mode = IMakinaXModule(MODULE).operatingMode();
        bool guarded = mode == WALLED;
        console2.log("operatingMode:", mode);

        uint256 amount = DEFAULT_AMOUNT;
        deal(BASE, SAFE, IERC20(BASE).balanceOf(SAFE) + amount);

        vm.prank(SAFE);
        IMakinaXModule(MODULE).addOperator(operator);

        IMakinaXModule.Instruction memory acct = _emptyInstr();
        if (guarded) {
            acct = _acctInstr();
            require(acct.commands.length != 0, "WALLED module but no ACCOUNTING instruction compiled: unsupported");
            _setupFeeds();
        }

        uint256 baseBefore = IERC20(BASE).balanceOf(SAFE);
        uint256 posBefore = IERC20(POSITION_TOKEN).balanceOf(SAFE);
        console2.log("base before:", baseBefore);
        console2.log("posToken before:", posBefore);

        // ---------- DEPOSIT ----------
        IMakinaXModule.Instruction memory dep = _depositInstr(amount);
        vm.prank(SAFE);
        IMakinaXModule(MODULE).setAllowedInstrRoot(_leaf(dep)); // single-leaf tree, empty proof
        vm.prank(operator);
        IMakinaXModule(MODULE).managePosition(dep, guarded ? acct : _emptyInstr());

        uint256 baseAfterDep = IERC20(BASE).balanceOf(SAFE);
        uint256 posAfterDep = IERC20(POSITION_TOKEN).balanceOf(SAFE);
        console2.log("base after deposit:", baseAfterDep);
        console2.log("posToken after deposit:", posAfterDep);
        assertEq(baseBefore - baseAfterDep, amount, "base token not pulled by supply");
        assertGt(posAfterDep, posBefore, "position token did not increase on deposit");

        // ---------- WITHDRAW (full balance via type(uint256).max) ----------
        IMakinaXModule.Instruction memory wd = _withdrawInstr(type(uint256).max);
        vm.prank(SAFE);
        IMakinaXModule(MODULE).setAllowedInstrRoot(_leaf(wd));
        vm.prank(operator);
        IMakinaXModule(MODULE).managePosition(wd, guarded ? acct : _emptyInstr());

        uint256 baseAfterWd = IERC20(BASE).balanceOf(SAFE);
        uint256 posAfterWd = IERC20(POSITION_TOKEN).balanceOf(SAFE);
        console2.log("base after withdraw:", baseAfterWd);
        console2.log("posToken after withdraw:", posAfterWd);
        assertLt(posAfterWd, posAfterDep, "position token did not decrease on withdraw");
        assertGe(baseAfterWd, baseBefore, "base token not returned by withdraw");
    }
}
